    {
      "parameters": {
        "jsCode": "// Parse Recipe Node\n\n// Get the LLM output\nconst raw =\n  $json.text ??\n  $json.response ??\n  $json.output ??\n  \"\";\n\n// Try to parse JSON first\nlet recipe;\n\ntry {\n  recipe = JSON.parse(raw);\n} catch {\n  // If the model returned markdown instead of JSON\n  recipe = {\n    title: \"Recipe\",\n    markdown: raw\n  };\n}\n\n// Try to infer title if missing\nif (!recipe.title) {\n  const match = recipe.markdown?.match(/^#\\s+(.+)$/m);\n  recipe.title = match ? match[1].trim() : \"Recipe\";\n}\n\nreturn [\n  {\n    json: {\n      title: recipe.title,\n      markdown: recipe.markdown || raw\n    }\n  }\n];"
      },

    {
      "parameters": {
        "jsCode": "// Parse the OpenRouter response safely\n\nconst response = $json;\n\n// Get the assistant message\nconst raw =\n\tresponse?.choices?.[0]?.message?.content || '{\"agent\":\"ignore\"}';\n\nlet parsed;\n\ntry {\n\tparsed = JSON.parse(raw);\n} catch (e) {\n\tparsed = { agent: \"ignore\" };\n}\n\n// Get the original message from the Extract URLs node\nconst original = $(\"Extract URLs\").first().json;\n\nreturn [\n\t{\n\t\tjson: {\n\t\t\t...original,\n\t\t\tagent: parsed.agent || \"ignore\"\n\t\t}\n\t}\n];"
      },

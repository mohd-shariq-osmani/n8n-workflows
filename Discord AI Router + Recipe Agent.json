    {
      "parameters": {
        "jsCode": "const text = $json.text || \"\";\nlet agent = \"ignore\";\ntry {\n  const cleanText = text.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n  const parsed = JSON.parse(cleanText);\n  agent = parsed.agent || \"ignore\";\n} catch (e) {\n  if (text.includes(\"recipe\")) agent = \"recipe-direct\";\n  else if (text.includes(\"project\")) agent = \"project\";\n  else if (text.includes(\"workout\")) agent = \"workout\";\n  else if (text.includes(\"media\") || text.includes(\"watch\")) agent = \"media\";\n}\n\n// Refine recipe agent if it contains instagram\nif (agent === \"recipe\" || agent === \"recipe-direct\" || agent === \"recipe-instagram\") {\n  const content = $node[\"Extract URLs\"].json.content || \"\";\n  if (content.includes(\"instagram.com\")) {\n    agent = \"recipe-instagram\";\n  } else {\n    agent = \"recipe-direct\";\n  }\n}\nreturn [{ json: { agent } }];"
      },

    {
      "parameters": {
        "jsCode": "const inputItems=$input.all();let messages=[];for(const item of inputItems){if(Array.isArray(item.json)){messages.push(...item.json);}else if(item.json){messages.push(item.json);}}const staticData=$getWorkflowStaticData('global');const lastId=staticData.lastMessageId||null;if(messages.length){const newest=messages.reduce((m,x)=>BigInt(x.id)>BigInt(m)?x.id:m,messages[0].id);staticData.lastMessageId=newest;}let newMessages=messages.filter(m=>!(m.author&&m.author.bot));if(lastId){newMessages=newMessages.filter(m=>BigInt(m.id)>BigInt(lastId));}else{newMessages=[];}newMessages.sort((a,b)=>BigInt(a.id)>BigInt(b.id)?1:-1);return newMessages.map(m=>({json:{messageId:m.id,content:m.content||'',author:m.author?.username||'',attachments:m.attachments||[]}}));"
      },

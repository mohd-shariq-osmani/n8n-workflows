      "id": "webhook-movie-tv",
      "name": "Webhook (Movie/TV Intake)",
      "webhookId": "movie-tv-intake"
    },
    {
      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\n\nconst results = [];\nfor (const item of $input.all()) {\n  const body = item.json.body || item.json;\n  const content = body.content || body.url || body.imdbUrl || body.link || JSON.stringify(body);\n\n  try {\n    const cmd = `python3 /usr/local/bin/media_dispatcher.py ${JSON.stringify(content)}`;\n    const stdout = execSync(cmd, { encoding: 'utf-8', timeout: 30000 });\n    const parsed = JSON.parse(stdout.trim());\n    results.push({\n      json: {\n        ...body,\n        ...parsed,\n        rawContent: content\n      }\n    });\n  } catch (err) {\n    results.push({\n      json: {\n        ...body,\n        success: false,\n        error: err.message || String(err),\n        rawContent: content\n      }\n    });\n  }\n}\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        50,
        200
      ],
      "id": "extract-route-media",
      "name": "Extract & Route Media"
    },
    {
      "parameters": {
